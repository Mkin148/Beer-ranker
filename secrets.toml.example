# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit the real secrets.toml (it's in .gitignore).

[auth]
# Local dev uses localhost; change to your deployed URL after deploying.
redirect_uri = "http://localhost:8501/oauth2callback"
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"
client_id = "REPLACE.apps.googleusercontent.com"
client_secret = "REPLACE_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[supabase]
url = "https://REPLACE.supabase.co"
# Use the SERVICE ROLE key (Project Settings → API). Server-side only.
service_key = "REPLACE_SERVICE_ROLE_KEY"
bucket = "beer-photos"

# Optional. Without this section, every logged-in user is treated as an
# admin (avoids lockout). Add it to restrict the Manage tab to specific
# Google accounts.
[admin]
emails = ["you@example.com", "another-admin@example.com"]
